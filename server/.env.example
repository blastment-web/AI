# 복사해서 .env 로 쓰거나 셸에서 export 하십시오. .env 는 .gitignore 대상입니다.

# ── 필수 ────────────────────────────────────────────────────────
# 서비스 계정 JSON 키 경로. 저장소 밖(예: ~/.gcp/key.json)에 두는 것을 권장합니다.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json
# 쿼리 비용이 청구될 GCP 프로젝트 ID (조회 대상 patents-public-data 가 아니라 '내' 프로젝트)
GCP_PROJECT=my-project-id

# ── 비용 가드 (기본값으로도 동작) ───────────────────────────────
# 단일 쿼리 최대 스캔량(GB). dry-run 견적이 이 값을 넘으면 실행하지 않고 거절합니다.
MAX_SCAN_GB=20
# 분당 최대 쿼리 수. 연타로 인한 비용 폭주를 막습니다.
MAX_QUERIES_PER_MIN=10
# 결과 캐시 유효시간(초). 같은 검색을 반복하면 BigQuery 를 다시 때리지 않습니다.
CACHE_TTL_SEC=86400

# ── 수집 어댑터 ─────────────────────────────────────────────────
# DART 오픈API 인증키. opendart.fss.or.kr 에서 무료 발급(40자).
# 어댑터 실행:  python -m adapters.capex_dart --from 2026-01-01 --to 2026-09-04
DART_API_KEY=

# ── 서버 ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# 쉼표 구분. file:// 로 직접 열 때를 위해 null 포함.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,null
